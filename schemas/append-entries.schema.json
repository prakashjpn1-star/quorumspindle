{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prakashjpn1-star/quorumspindle/schemas/append-entries.schema.json",
  "title": "Raft replication request",
  "type": "object",
  "properties": {
    "cluster_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "rpc_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "term": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "leader_id": {
      "enum": [
        "node-a",
        "node-b",
        "node-c"
      ]
    },
    "prev_log_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "prev_log_term": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "leader_commit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "term": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "entry_type": {
            "enum": [
              "COMMAND",
              "NOOP"
            ]
          },
          "command": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "client_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "operation_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "key": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "kind": {
                        "const": "PUT"
                      },
                      "value_base64": {
                        "type": "string",
                        "contentEncoding": "base64",
                        "maxLength": 1368,
                        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                      }
                    },
                    "required": [
                      "client_id",
                      "operation_id",
                      "key",
                      "kind",
                      "value_base64"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "client_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "operation_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "key": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "kind": {
                        "const": "CAS"
                      },
                      "expected_version": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "value_base64": {
                        "type": "string",
                        "contentEncoding": "base64",
                        "maxLength": 1368,
                        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                      }
                    },
                    "required": [
                      "client_id",
                      "operation_id",
                      "key",
                      "kind",
                      "expected_version",
                      "value_base64"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "client_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "operation_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "key": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "kind": {
                        "const": "DELETE"
                      },
                      "expected_version": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "client_id",
                      "operation_id",
                      "key",
                      "kind",
                      "expected_version"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "client_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "operation_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "key": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "kind": {
                        "const": "READ"
                      }
                    },
                    "required": [
                      "client_id",
                      "operation_id",
                      "key",
                      "kind"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "payload_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "index",
          "term",
          "entry_type",
          "command",
          "payload_digest"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    }
  },
  "required": [
    "cluster_id",
    "rpc_id",
    "term",
    "leader_id",
    "prev_log_index",
    "prev_log_term",
    "leader_commit",
    "entries"
  ],
  "additionalProperties": false
}
