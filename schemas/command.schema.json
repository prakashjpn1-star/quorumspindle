{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prakashjpn1-star/quorumspindle/schemas/command.schema.json",
  "title": "Replicated client command",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "client_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "const": "PUT"
        },
        "value_base64": {
          "type": "string",
          "contentEncoding": "base64",
          "maxLength": 1368,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      },
      "required": [
        "client_id",
        "operation_id",
        "key",
        "kind",
        "value_base64"
      ],
      "additionalProperties": false
    },
    {
