{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prakashjpn1-star/quorumspindle/schemas/fault-schedule.schema.json",
  "title": "Bounded directed local fault schedule",
  "type": "object",
  "properties": {
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60000
    },
    "faults": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "kind": {
            "enum": [
              "DROP",
              "DELAY",
              "DUPLICATE",
              "DISCONNECT",
              "KILL",
              "RESTART"
            ]
          },
          "source": {
            "enum": [
              "node-a",
              "node-b",
              "node-c"
            ]
          },
          "target": {
            "enum": [
              "node-a",
              "node-b",
              "node-c"
            ]
          },
          "delay_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000
          }
        },
        "required": [
          "at_ms",
          "kind",
          "source"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "seed",
    "duration_ms",
    "faults"
  ],
  "additionalProperties": false
}
