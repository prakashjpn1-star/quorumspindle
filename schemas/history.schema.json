{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prakashjpn1-star/quorumspindle/schemas/history.schema.json",
  "title": "Bounded checker input history",
  "type": "object",
  "properties": {
    "classification": {
      "enum": [
        "KNOWN_LEGAL",
        "KNOWN_ILLEGAL",
        "OBSERVED"
      ]
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "invoke_tick": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "return_tick": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "command": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "client_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "operation_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "kind": {
                    "const": "PUT"
                  },
                  "value_base64": {
                    "type": "string",
                    "contentEncoding": "base64",
                    "maxLength": 1368,
                    "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                  }
                },
                "required": [
                  "client_id",
                  "operation_id",
                  "key",
                  "kind",
                  "value_base64"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "client_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "operation_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "kind": {
                    "const": "CAS"
                  },
                  "expected_version": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "value_base64": {
                    "type": "string",
                    "contentEncoding": "base64",
                    "maxLength": 1368,
                    "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                  }
                },
                "required": [
                  "client_id",
                  "operation_id",
                  "key",
                  "kind",
                  "expected_version",
                  "value_base64"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "client_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "operation_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "kind": {
                    "const": "DELETE"
                  },
                  "expected_version": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "client_id",
                  "operation_id",
                  "key",
                  "kind",
                  "expected_version"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "client_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "operation_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "kind": {
                    "const": "READ"
                  }
                },
                "required": [
                  "client_id",
                  "operation_id",
                  "key",
                  "kind"
                ],
                "additionalProperties": false
              }
            ]
          },
          "result": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "OK",
                      "VERSION_CONFLICT",
                      "REQUEST_ID_CONFLICT",
                      "NOT_LEADER",
                      "UNAVAILABLE",
                      "OVERLOAD",
                      "OUTCOME_UNKNOWN"
                    ]
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "present": {
                    "type": "boolean"
                  },
                  "value_base64": {
                    "type": "string",
                    "contentEncoding": "base64",
                    "maxLength": 1368,
                    "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                  }
                },
                "required": [
                  "status"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "invoke_tick",
          "return_tick",
          "command",
          "result"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 200
    }
  },
  "required": [
    "classification",
    "operations"
  ],
  "additionalProperties": false
}
