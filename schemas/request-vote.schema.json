{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prakashjpn1-star/quorumspindle/schemas/request-vote.schema.json",
  "title": "Raft vote request",
  "type": "object",
  "properties": {
    "cluster_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "rpc_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "term": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "candidate_id": {
      "enum": [
        "node-a",
        "node-b",
        "node-c"
      ]
    },
    "last_log_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "last_log_term": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "cluster_id",
    "rpc_id",
    "term",
    "candidate_id",
    "last_log_index",
    "last_log_term"
  ],
  "additionalProperties": false
}
